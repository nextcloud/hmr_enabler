{
    "name": "nextcloud/hmr-enabler",
    "description": "Nextcloud HMR Enabler",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Louis Chemineau",
            "email": "louis@chmn.me"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^10.5.63",
        "nextcloud/coding-standard": "1.5.0",
        "nextcloud/ocp": "dev-master",
        "vimeo/psalm": "^6.16.1"
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "platform": {
            "php": "8.1.31"
        }
    },
    "scripts": {
        "test:unit": "phpunit -c tests/phpunit.xml --colors=always --fail-on-warning --fail-on-risky --display-deprecations --display-phpunit-deprecations",
        "psalm": "psalm --no-cache --threads=$(nproc)",
        "psalm:update-baseline": "psalm --threads=1 --update-baseline",
        "lint": "find . -name \\*.php -not -path './vendor/*' -not -path './build/*' -print0 | xargs -0 -n1 php -l",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    }
}
